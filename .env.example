# MeerkaT3 needs no .env file for the supported local desktop build.
# Add model accounts in Settings > Providers after launching the app.
# Never commit API keys, OAuth tokens, pairing links, or application profiles.

# Optional development overrides. The dev runner chooses free loopback ports
# automatically; use an offset only when you need a predictable starting point.
# T3CODE_PORT_OFFSET=100

# Use the --home-dir argument to select an isolated test profile:
# pnpm dev --home-dir /tmp/meerkat-t3-dev
# See docs/operations/development.md for pairing and state isolation.
